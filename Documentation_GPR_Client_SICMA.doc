  <tr><td>open2</td><td>false</td><td>Dialog confirmation envoi</td></tr>
  <tr><td>files</td><td>[]</td><td>Pièces jointes</td></tr>
  <tr><td>isLoading</td><td>false</td><td>Chargement</td></tr>
  <tr><td>actif</td><td>false</td><td>État bouton soumettre</td></tr>
  <tr><td>showSmsBox</td><td>false</td><td>Affiche boîte SMS</td></tr>
  <tr><td>showAudioBox</td><td>false</td><td>Affiche enregistreur audio</td></tr>
