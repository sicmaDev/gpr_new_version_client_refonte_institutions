<h2>Pattern standard des actions</h2>
<pre>// Action Creator
export const itemsChanged = (items) => ({
  type: "ITEMS_CHANGED",
  payload: items
});

// mapDispatchToProps
const mapDispatchToProps = (dispatch) => ({
  itemsChanged: (items) => dispatch(itemsChanged(items)),
  loading: (err) => dispatch(loading(err))
});</pre>

